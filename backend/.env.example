# Copy to backend/.env and adjust. Never commit the real .env.

# --- Database ----------------------------------------------------------------
# Either a URL ...
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5433/catalogue_db
# ... or discrete settings (used when DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=catalogue_db

# Tests always use a separate database (created and migrated automatically).
# PGDATABASE_TEST=catalogue_test
# TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5433/catalogue_test

# PGPOOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=30000

# --- HTTP --------------------------------------------------------------------
PORT=3000
# Public base URL used in TMF620 href values (derived from the request when unset)
# PUBLIC_BASE_URL=https://catalogue.example.com
# Extra browser origins allowed to call the API (the bundled UIs are same-origin)
# CORS_ORIGINS=https://crm.example.com
# TRUST_PROXY=loopback
# LOG_LEVEL=info

# --- Authentication ------------------------------------------------------------
# Unset = development mode: the caller's tenant comes from the x-tenant-id header.
# Set = every request needs a key; the key decides the tenant. Required when NODE_ENV=production.
# Format: <key>:<tenant uuid>:<admin|reader>, separated by ";" (keys at least 16 characters)
# API_KEYS=change-me-admin-key-0001:17000000-0000-4000-a000-000000000000:admin;change-me-crm-key-00002:17000000-0000-4000-a000-000000000000:reader
# NODE_ENV=production
