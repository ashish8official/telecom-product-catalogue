{
  "name": "telecom-product-catalogue-backend",
  "version": "1.0.0",
  "description": "Multi-tenant telecom product catalogue engine with a TMF620 adapter layer",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node --transpile-only server.ts",
    "dev": "ts-node server.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "jest",
    "test:db": "ts-node --transpile-only scripts/db.ts test --test",
    "db:migrate": "ts-node --transpile-only scripts/db.ts migrate",
    "db:rollback": "ts-node --transpile-only scripts/db.ts rollback",
    "db:status": "ts-node --transpile-only scripts/db.ts status",
    "db:baseline": "ts-node --transpile-only scripts/db.ts baseline",
    "db:seed": "ts-node --transpile-only scripts/db.ts seed",
    "db:verify-rollback": "ts-node --transpile-only scripts/db.ts verify-rollback",
    "smoke": "ts-node --transpile-only scripts/smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "ajv": "^8.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
